# =============================================================================
# CocoCarbon AI - Environment Variables Template
# Copy to .env and replace placeholder values. NEVER commit .env or real keys.
# =============================================================================

# --- PostgreSQL + PostGIS ---
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=cococarbon
POSTGRES_USER=cococarbon_app
POSTGRES_PASSWORD=CHANGE_ME_STRONG_POSTGRES_PASSWORD
ConnectionStrings__DefaultConnection=Host=postgres;Port=5432;Database=cococarbon;Username=cococarbon_app;Password=CHANGE_ME_STRONG_POSTGRES_PASSWORD

# --- Firebase Authentication (Shared project for Web + Android) ---
# Path to Firebase service account JSON mounted outside git (or JSON in secret manager)
FIREBASE_PROJECT_ID=CHANGE_ME_FIREBASE_PROJECT_ID
FIREBASE_SERVICE_ACCOUNT_PATH=/run/secrets/firebase-service-account.json
# Development/Demo ONLY. Must be false in production!
FIREBASE_AUTH_DEV_ALLOW_MOCK=false

# --- Web Firebase Public Config (Client SDK) ---
NEXT_PUBLIC_FIREBASE_API_KEY=CHANGE_ME_FIREBASE_WEB_API_KEY
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=CHANGE_ME_PROJECT.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=CHANGE_ME_FIREBASE_PROJECT_ID
NEXT_PUBLIC_FIREBASE_APP_ID=CHANGE_ME_FIREBASE_WEB_APP_ID
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080
NEXT_PUBLIC_SHOW_DEMO_MODE=true

# --- C# ASP.NET Core Web API ---
ASPNETCORE_ENVIRONMENT=Production
ASPNETCORE_URLS=http://+:8080
CORS_ALLOWED_ORIGINS=http://localhost:3000,https://your-domain.example
SIGNED_URL_SECRET=CHANGE_ME_64_CHAR_HMAC_SECRET_FOR_PRIVATE_FILE_URLS
ADMIN_BOOTSTRAP_EMAILS=admin@example.com

# --- Private Object Storage (local or s3) ---
STORAGE_PROVIDER=local
LOCAL_STORAGE_ROOT=/app/storage
S3_ENDPOINT=http://minio:9000
S3_BUCKET=cococarbon-private
S3_ACCESS_KEY=CHANGE_ME_MINIO_ACCESS_KEY
S3_SECRET_KEY=CHANGE_ME_MINIO_SECRET_KEY
MAX_UPLOAD_BYTES=15728640

# --- Internal AI Service Connection (C# -> Python private network only) ---
AI_SERVICE_URL=http://ai-service:8000
AI_SERVICE_INTERNAL_KEY=CHANGE_ME_INTERNAL_SERVICE_SHARED_SECRET
AI_SERVICE_TIMEOUT_SECONDS=35

# --- Python FastAPI + Gemini API ---
AI_PROVIDER=gemini
GEMINI_API_KEY=CHANGE_ME_GEMINI_API_KEY
GEMINI_MODEL=gemini-4-hydrogen
PROMPT_VERSION=coco-auditor-v1.0
AI_REQUEST_TIMEOUT_SECONDS=25
AI_MAX_FILE_BYTES=15728640
AI_MAX_RETRIES=2
